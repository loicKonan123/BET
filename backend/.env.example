# Copie ce fichier en .env et mets tes vraies clés
# API-Football (api-football.com — endpoint direct api-sports.io)
API_FOOTBALL_KEY=ta_cle_ici

# DeepSeek (cerveau analyste — API compatible OpenAI)
DEEPSEEK_API_KEY=ta_cle_deepseek
# Mode rapide : rédaction directe, un seul appel, sans raisonnement prolongé.
# Les anciens alias deepseek-reasoner/chat utilisent v4-flash dans ce mode.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ANALYSIS_MODE=rapide
DEEPSEEK_MAX_TOKENS=8192
# Pour privilégier le raisonnement au délai : mode approfondi et budget 32768.
